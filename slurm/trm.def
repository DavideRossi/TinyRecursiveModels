Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04

# Software-only image for TinyRecursiveModels.
# Code, data and checkpoints live outside the image (bind-mounted at run time).
# Versions follow specific_requirements.txt.
#
# Ubuntu 24.04 (glibc 2.39) is required: the cluster's Apptainer injects a
# libfakeroot that needs glibc >= 2.38, so a 22.04 base fails in %post.
# 24.04 ships Python 3.12 and forbids system-wide pip (PEP 668), hence the venv.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv git build-essential ca-certificates
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    PY=/opt/venv/bin/python

    $PY -m pip install --no-cache-dir --upgrade pip wheel==0.45.1 setuptools==80.9.0

    $PY -m pip install --no-cache-dir torch==2.7.0 \
        --index-url https://download.pytorch.org/whl/cu126

    $PY -m pip install --no-cache-dir \
        triton==3.3.0 \
        einops==0.8.1 \
        tqdm==4.67.1 \
        coolname==2.2.0 \
        pydantic==2.11.7 \
        pydantic-core==2.33.2 \
        argdantic==1.3.3 \
        wandb==0.21.3 \
        omegaconf==2.3.0 \
        hydra-core==1.3.2 \
        huggingface_hub==0.34.4 \
        packaging==24.1 \
        ninja==1.13.0 \
        setuptools-scm==9.2.0 \
        numba==0.61.2

    # adam-atan2 compiles a CUDA extension. The build node has no GPU, so the
    # target architecture must be given explicitly (L40S = Ada, sm_89).
    export TORCH_CUDA_ARCH_LIST="8.9"
    $PY -m pip install --no-cache-dir --no-build-isolation adam-atan2==0.0.3

    # Fail the build early if anything is missing.
    $PY -c "import torch, triton, adam_atan2, hydra, wandb; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

%labels
    Description TinyRecursiveModels training environment (torch 2.7.0 / CUDA 12.6)
